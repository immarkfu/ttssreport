# 后端基础镜像 - 包含所有大型/慢速依赖
# 只在 requirements.txt 中大包变更时才需要重新构建此镜像
# 构建命令：docker build -f Dockerfile.backend-base -t ttssreport-backend-base:latest .
FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 安装大型/慢速依赖（使用阿里云镜像源）
# 这些包体积大，变更频率低，适合放在基础镜像中
RUN pip install --no-cache-dir \
    --index-url https://mirrors.aliyun.com/pypi/simple/ \
    --trusted-host mirrors.aliyun.com \
    tushare==1.4.4 \
    pandas==2.1.4 \
    numpy==1.26.2 \
    volcengine_python_sdk==5.0.7 \
    sqlalchemy==2.0.23
